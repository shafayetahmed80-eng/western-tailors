APP_NAME=WesternBespoke
APP_ENV=production
# Set APP_DEBUG=true temporarily if you encounter 500 error, then set back to false
APP_DEBUG=false
# Replace with your Hostinger Temporary/Preview domain or your real domain (with https://)
APP_URL=https://your-preview-domain.hostingerpreview.com
APP_KEY=base64:aupx1RSuyw8STqR4i3nxG5Xks5OGwbZN5xelUG0NVPE=
LOG_CHANNEL=daily

BROADCAST_DRIVER=log
CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

SESSION_HTTP_ONLY=true
# Set to true if temporary domain has SSL/HTTPS enabled, false if HTTP only
SESSION_SECURE_COOKIE=false
ENABLE_HTTP_SECURITY_HEADERS=true

# Hostinger MySQL Database Credentials
# Find these in Hostinger hPanel -> Databases -> Management
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u123456789_dbname
DB_USERNAME=u123456789_dbuser
DB_PASSWORD="your_database_password_here"
DB_STRICT=false

ADMIN_DIR=admin
CMS_ENABLE_INSTALLER=false
CMS_MAX_EXECUTION_TIME=0
